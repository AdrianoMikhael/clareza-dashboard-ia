# Usado na execução Python local. No Docker, compose.yaml define os hosts internos.
DATABASE_URL=postgresql+psycopg://dashboard:dashboard_local@localhost:5433/dashboard
POSTGRES_PASSWORD=dashboard_local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
AI_BACKEND=ollama
# O worker é opcional; não é necessário para ensinar pela interface.
RETRY_INTERVAL_SECONDS=3600
